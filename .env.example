# Salin menjadi .env lalu sesuaikan.
# File .env hanya dibaca oleh aplikasi React (variabel REACT_APP_*).
REACT_APP_API_URL=http://localhost/api

# Catatan: APP_ORIGIN, DB_HOST, DB_USER, DB_PASS, DB_NAME, dan DB_TABLE
# dibaca oleh api/login.php dari environment server PHP (mis. SetEnv di
# Apache/vhost), BUKAN dari file .env React ini. Contoh:
#   APP_ORIGIN=http://localhost:3000,https://arsip.contoh.go.id
